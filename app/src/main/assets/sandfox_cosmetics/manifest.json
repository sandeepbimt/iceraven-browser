{
  "manifest_version": 2,
  "name": "Sandfox Native Protection",
  "version": "2.0.0",
  "description": "Sandfox native protection powered by Brave adblock-rust.",
  "browser_specific_settings": { "gecko": { "id": "sandfox-adblock@sandfox" } },
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true }
  ],
  "permissions": ["webRequest", "webRequestBlocking", "<all_urls>", "nativeMessaging", "geckoViewAddons"]
}
