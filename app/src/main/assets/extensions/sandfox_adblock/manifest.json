{
  "manifest_version": 2,
  "name": "Sandfox Native Adblock Bridge",
  "version": "1.0.0",
  "description": "Sandfox V1-A Brave adblock-rust network blocker.",
  "permissions": ["<all_urls>", "webRequest", "webRequestBlocking", "storage"],
  "background": { "page": "background.html" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true }],
  "browser_specific_settings": {
    "gecko": { "id": "sandfox-adblock@sandfox.browser" }
  }
}
