{
  "manifest_version": 2,
  "name": "Sandfox Native Adblock Bridge",
  "version": "1.0.0",
  "description": "Sandfox V1 Brave adblock-rust bridge.",
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "storage"
  ],
  "background": {
    "page": "background.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "sandfox-adblock@sandfox.browser"
    }
  }
}
