{
  "manifest_version": 2,
  "name": "SANDFOX Dark Pages",
  "version": "4.0.0",
  "description": "SANDFOX first-party Smart Dark renderer.",
  "browser_specific_settings": {
    "gecko": {"id": "sandfox-dark-pages@sandfox.local", "strict_min_version": "128.0"},
    "gecko_android": {"strict_min_version": "128.0"}
  },
  "permissions": ["storage", "tabs", "geckoViewAddons", "nativeMessaging"],
  "background": {"scripts": ["background.js"]},
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true
  }]
}